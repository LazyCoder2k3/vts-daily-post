name: VTS daily Strava post

on:
  schedule:
    # GitHub hay trễ nhiều giờ ở phút :00 và :30, nên tránh hai phút đó.
    # Hai lượt snapshot dự phòng nhau; lượt đúng giờ muộn nhất được giữ.
    - cron: "20 16 * * *"   # 23:20 giờ VN – chụp /ranking + /today
    - cron: "50 16 * * *"   # 23:50 giờ VN – chụp lại (số liệu cuối ngày)
    - cron: "47 23 * * *"   # 06:47 giờ VN – soạn bài và gửi qua Telegram
  workflow_dispatch:
    inputs:
      command:
        description: "Lệnh cần chạy"
        type: choice
        options: [post, snapshot, post-dry-run]
        default: post

permissions:
  contents: write            # để lưu snapshot/bài đăng ngược vào repo

concurrency:
  group: vts-daily
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - run: pip install -r requirements.txt

      - name: Chọn lệnh
        id: cmd
        env:
          EVENT: ${{ github.event_name }}
          SCHEDULE: ${{ github.event.schedule }}
          INPUT_CMD: ${{ inputs.command }}
        run: |
          echo "Bắt đầu lúc (giờ VN): $(TZ=Asia/Ho_Chi_Minh date '+%Y-%m-%d %H:%M:%S')"
          if [ "$EVENT" = "workflow_dispatch" ]; then
            c="$INPUT_CMD"
          else
            case "$SCHEDULE" in
              "20 16 * * *"|"50 16 * * *") c="snapshot" ;;
              "47 23 * * *") c="post" ;;
              *) echo "::error::Lịch không nhận diện được: '$SCHEDULE'"; exit 1 ;;
            esac
          fi
          [ "$c" = "post-dry-run" ] && c="post --dry-run"
          echo "args=$c" >> "$GITHUB_OUTPUT"
          echo "Lệnh: $c"

      - name: Chạy bot
        env:
          TG_API_ID: ${{ secrets.TG_API_ID }}
          TG_API_HASH: ${{ secrets.TG_API_HASH }}
          TG_SESSION_STRING: ${{ secrets.TG_SESSION_STRING }}
          NOTIFY_BOT_TOKEN: ${{ secrets.NOTIFY_BOT_TOKEN }}
          NOTIFY_CHAT_ID: ${{ secrets.NOTIFY_CHAT_ID }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          LLM_PROVIDER: ${{ vars.LLM_PROVIDER }}
          HASHTAGS: ${{ vars.HASHTAGS }}
          SHOW_DAILY_KM: ${{ vars.SHOW_DAILY_KM }}
        run: python main.py ${{ steps.cmd.outputs.args }}

      - name: Lưu dữ liệu vào repo
        if: always()
        run: |
          git config user.name "vts-daily-bot"
          git config user.email "vts-daily-bot@users.noreply.github.com"
          git add data || exit 0
          if git diff --cached --quiet; then echo "Không có dữ liệu mới"; exit 0; fi
          git commit -m "data: $(TZ=Asia/Ho_Chi_Minh date '+%Y-%m-%d %H:%M')"
          for i in 1 2 3 4; do
            git pull --rebase && git push && exit 0
            echo "Push lần $i thất bại, thử lại..."; sleep $((i * 5))
          done
          echo "::error::Không push được dữ liệu lên repo"; exit 1
