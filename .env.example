# ===== Userbot Telegram (dùng để hỏi /ranking và /today với @tdht_bot) =====
# Lấy tại https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Chuỗi session in ra khi chạy: python main.py login
TG_SESSION_STRING=
TDHT_BOT=tdht_bot

# ===== Bot nhận bài (tạo bằng @BotFather) =====
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# ===== Thông tin giải (theo KH 233/KH-CĐBP) =====
EVENT_START=2026-09-15
EVENT_END=2026-10-14
ANNIVERSARY=2026-10-15
FOUNDED_YEAR=2018
TARGET_KM=45
HASHTAGS=#VTSRunningClub #8NamVTS
# 1 = hiện số km ở mục top 3 trong ngày, 0 = chỉ hiện tên
SHOW_DAILY_KM=1
# Quy đổi km theo loại vận động khi tổng hợp từ /today
DAILY_RIDE_FACTOR=0.25
DAILY_SWIM_FACTOR=4
DAILY_RIDE_TYPES=ride,bike,cycle,ebike,virtualride
DAILY_SWIM_TYPES=swim

# ===== Viết lại bằng AI (tùy chọn): none | anthropic | gemini =====
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
