# =====================================================================
#  Bot thống kê chạy bộ VTS Running Club (Strava -> Telegram)
#  Copy file này thành .env rồi điền giá trị. KHÔNG commit .env.
#
#  Quy ước:
#   - Biến số (ID, số ngày...) KHÔNG để trống: không dùng thì giữ nguyên dấu #.
#   - true/false hoặc 1/0 cho biến bật/tắt.
# =====================================================================

# ---------- Strava API app (https://www.strava.com/settings/api) ----------
# Client ID và Client Secret của app. Authorization Callback Domain = tên miền của bạn (không có https://).
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chuỗi bí mật tuỳ ý, Strava gửi lại khi xác minh webhook. Đổi thì phải subscribe lại.
STRAVA_WEBHOOK_VERIFY_TOKEN=doi-chuoi-nay-di
# Quyền xin runner. "read,activity:read" bỏ qua hoạt động "Only You"; "read,activity:read_all" đọc cả private.
STRAVA_SCOPE=read,activity:read
# Base URL API/OAuth. Từ 04/01/2027 Strava chuyển sang https://api-v3.strava.com — đổi ở đây, không cần sửa code.
STRAVA_API_BASE=https://www.strava.com/api/v3
STRAVA_OAUTH_BASE=https://www.strava.com/oauth
# (tuỳ chọn) ID club Strava: khi kết nối, bot kiểm tra runner có trong club không (cần scope read).
# STRAVA_CLUB_ID=123456

# ---------- Máy chủ ----------
# URL công khai HTTPS mà Strava gọi về (OAuth callback + webhook). Không có dấu / cuối.
PUBLIC_BASE_URL=https://run.example.com
# Địa chỉ/cổng uvicorn lắng nghe (trong Docker giữ nguyên).
HOST=0.0.0.0
PORT=8080

# ---------- Telegram ----------
# Token bot từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram ID của admin, cách nhau bằng dấu phẩy. Lấy bằng lệnh /id với bot.
ADMIN_TELEGRAM_IDS=111111111,222222222
# ID nhóm kín nhận bài sáng (số âm với supergroup). Lấy bằng /id trong nhóm. Không dùng thì giữ dấu #.
# GROUP_CHAT_ID=-1001234567890
# Nhắn riêng runner khi hoạt động bị loại (kèm lý do)
NOTIFY_REJECTED_DM=true
# Nhắn riêng runner khi hoạt động hợp lệ
NOTIFY_VALID_DM=false
# Báo vào nhóm mỗi hoạt động hợp lệ (ồn, mặc định tắt)
NOTIFY_VALID_GROUP=false
# Bài sáng gửi thẳng vào nhóm (true) hay chỉ gửi admin duyệt (false)
AUTO_POST_GROUP=false
# Giờ soạn bài sáng, HH:MM theo TIMEZONE
DAILY_POST_TIME=06:30
TIMEZONE=Asia/Ho_Chi_Minh

# ---------- Lưu trữ ----------
# Chạy local: ./data/vts.db. Trong Docker compose đã ghi đè thành sqlite+aiosqlite:////app/data/vts.db
DATABASE_URL=sqlite+aiosqlite:///./data/vts.db
# Khoá Fernet mã hoá token Strava trong DB. Tạo bằng: python -m app.cli gen-key
# Trống = lưu thô (chỉ khi thử nghiệm). Mất khoá = mọi runner phải /connect lại.
TOKEN_ENCRYPTION_KEY=
# Thư mục backup SQLite (trong Docker compose đã ghi đè thành /app/data/backups)
BACKUP_DIR=./data/backups
# Số bản backup giữ lại
BACKUP_KEEP=14
# Xoá JSON thô của hoạt động sau N ngày (chính sách dữ liệu Strava); số liệu đã chấm vẫn giữ.
RAW_RETENTION_DAYS=7

# ---------- Lịch nền ----------
# Đối soát với Strava mỗi N giờ (bù webhook bị lỡ, phát hiện hoạt động đã xoá)
RECONCILE_INTERVAL_HOURS=3
# Mỗi lần đối soát nhìn lùi N ngày
RECONCILE_LOOKBACK_DAYS=2

# ---------- Soạn bài sáng (composer) ----------
# Viết lại bài bằng AI: none | anthropic | gemini
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hashtag cuối bài
HASHTAGS=#VTSRunningClub
# true = hiện số km ở top ngày; false = chỉ hiện tên
SHOW_DAILY_KM=true
# Năm thành lập để tính "N năm VTS" trong bài. Không nhắc thì giữ dấu #.
FOUNDED_YEAR=2018

# Mức log: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# ---------- Chỉ dùng cho docker compose (không phải biến của app) ----------
# deploy/docker-compose.yml: tên miền để Caddy xin chứng chỉ HTTPS (trùng với PUBLIC_BASE_URL, bỏ https://)
DOMAIN=run.example.com
# deploy/docker-compose.cloudflared.yml: token của Cloudflare Tunnel
# CF_TUNNEL_TOKEN=eyJhIjoi...
